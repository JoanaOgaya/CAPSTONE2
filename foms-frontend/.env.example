# FOMS Web Application Environment Configuration
# Ports: Dev 5173 | Preview 4173 (strictPort: true)

# Base URL of the FOMS REST API (defaults to backend on port 5007)
VITE_API_URL=http://localhost:5007

# Base URL of the SpeedPay REST API (used by SpeedPay Validation)
VITE_SPEEDPAY_API_URL=http://localhost:4000

# Standalone SpeedPay Web App URL
VITE_SPEEDPAY_APP_URL=http://localhost:5174

# WebSocket/SSE endpoint for realtime events (relative to current host)
VITE_WS_URL=/ws

# Polling fallback interval in ms (10000-15000)
VITE_POLL_INTERVAL_MS=15000

# Inactivity auto-logout in ms
VITE_INACTIVITY_TIMEOUT_MS=1800000
