# =====================================================================
# Finance Operations Management System (FOMS) & AI Intelligence Layer
# Local & CI/CD Environment Configuration Template (.env.example)
# =====================================================================
# IMPORTANT:
# 1. DO NOT commit actual secrets, API keys, or production passwords here.
# 2. Copy this template to .env for local development:
#    cp .env.example .env
# =====================================================================

# ASP.NET Core Web API / Backend Service (FOMS.Api)
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5007
PORT=5007

# Microsoft SQL Server (Official FOMS Source of Truth)
MSSQL_SERVER=localhost\SQLEXPRESS
MSSQL_DATABASE=FOMS_DB
MSSQL_DB=FOMS_DB
MSSQL_TRUSTED_CONNECTION=yes
MSSQL_TRUST_SERVER_CERTIFICATE=True
MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# Standard SQL Server ADO.NET / .NET Connection Strings
MSSQL_CONNECTION_STRING=Server=localhost\SQLEXPRESS;Database=FOMS_DB;Trusted_Connection=yes;TrustServerCertificate=True;
# Leave these unset for Docker Compose so it can use host.docker.internal:
# ConnectionStrings__FomsSqlServer=Server=localhost\SQLEXPRESS;Database=FOMS_DB;Trusted_Connection=yes;TrustServerCertificate=True;
# ConnectionStrings__DefaultConnection=Server=localhost\SQLEXPRESS;Database=FOMS_DB;Trusted_Connection=yes;TrustServerCertificate=True;

# Python / SQLAlchemy Driver String (mssql+pyodbc)
MSSQL_SQLALCHEMY_URL=mssql+pyodbc://@localhost\SQLEXPRESS/FOMS_DB?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes

# Azure SQL Database Template (for cloud deployment)
# ConnectionStrings__FomsSqlServer=Server=tcp:<YOUR_SERVER>.database.windows.net,1433;Initial Catalog=FOMS_DB;Persist Security Info=False;User ID=fomsadmin;Password=<YOUR_PASSWORD>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# JWT Security & Service Authentication
JWT_SECRET=FOMS_Capstone_JWT_SecureKey_2026!!
JWT_ISSUER=FOMS.Api
JWT_AUDIENCE=FOMS.Api
JWT_EXPIRES_MINUTES=120
FOMS_JWT_ISSUER=FOMS.Api
FOMS_JWT_AUDIENCE=FOMS.Api

# PostgreSQL & pgAdmin (AI Output & Analytics Store)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=foms_ai_results
POSTGRES_DB=foms_ai_results
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/foms_ai_results

# MongoDB (AI Telemetry & Trends Store)
MONGODB_URI=mongodb://user:password@localhost:27017
MONGODB_DATABASE=foms_trends_db
MONGO_DB=foms_trends_db

# Google Gemini API & Document AI Provider
GEMINI_API_KEY=your_gemini_api_key
AI_MODEL_NAME=gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=foms-secret-key-2026

# PayMongo & SpeedPay Gateway Integration
PAYMONGO_SECRET_KEY=your_paymongo_secret_key_here
PAYMONGO_PUBLIC_KEY=your_paymongo_public_key_here
PAYMONGO_WEBHOOK_SECRET=your_paymongo_webhook_secret_here
SPEEDPAY_API_BASE_URL=http://localhost:5174
VITE_SPEEDPAY_API_URL=http://localhost:5007
VITE_SPEEDPAY_APP_URL=http://localhost:5174

# Core APIs & CORS Bindings
FOMS_API_URL=http://localhost:5007
FOMS_READ_API_URL=http://localhost:5007
VITE_API_URL=http://localhost:5007
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:4173,http://localhost:3000

# File Upload & Document Validation Constraints
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf

# Feature Flags & Strict Database Mode
ENABLE_SPEEDPAY=true
ENABLE_AI_SCAN=true
ENABLE_DOCUMENT_EXTRACTION=true
ENABLE_MOCK_DATA=false
ENABLE_SEED_FALLBACK=false
# Inserts duplicate-review demo records during duplicate API reads; keep false outside demo environments.
ENABLE_DUPLICATE_SAMPLE_DATA=false
PGADMIN_DEFAULT_PASSWORD=replace_with_a_local_pgadmin_password
MONGO_ROOT_PASSWORD=replace_with_a_local_mongodb_password
